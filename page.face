<section class="pad intro" id="pillars">
  <div class="wrap">
    <div data-reveal>
      <div class="eyebrow" style="margin-bottom:14px;">What we do</div>
      <p class="lead">Crowd9 is a creative studio that works on <b>new ideas and brings them to reality</b> — events, ad films, artwork, media, and corporate gifting, built by one team under one roof. We don't just execute briefs, we imagine what a brand could be.</p>
    </div>

    <div class="pillar-card glass" style="margin-top:32px;" data-reveal>
      <div class="pillar-tabs">
        <button class="pillar-tab active" data-tab="events">Events &amp; Activation</button>
        <button class="pillar-tab" data-tab="content">Content &amp; Production</button>
        <button class="pillar-tab" data-tab="media">Media &amp; Growth</button>
      </div>
      <div class="pillar-panels">
        <div class="pillar-panel active" data-panel="events">
          <div class="pillar-item"><h4>Events</h4><p>Launches and corporate events, imagined and staged end to end.</p></div>
          <div class="pillar-item"><h4>BTL Activations</h4><p>Canter vans, dealer meets, campus outreach that meets people where they are.</p></div>
          <div class="pillar-item"><h4>Corporate Gifting</h4><p>Curated programmes that keep a brand top of mind.</p></div>
        </div>
        <div class="pillar-panel" data-panel="content">
          <div class="pillar-item"><h4>TV Advertisements</h4><p>Commercials built for reach, from first script to final cut.</p></div>
          <div class="pillar-item"><h4>Video Content</h4><p>Brand films, UGC, AI animation, testimonials.</p></div>
          <div class="pillar-item"><h4>Artwork Designing</h4><p>Press ads, posters, OOH, packshots — press-ready, on brand.</p></div>
        </div>
        <div class="pillar-panel" data-panel="media">
          <div class="pillar-item"><h4>Media Planning</h4><p>Right channels, right spend, right moment.</p></div>
          <div class="pillar-item"><h4>Social &amp; Digital</h4><p>Platform-native content that keeps a brand alive between big launches.</p></div>
          <div class="pillar-item"><h4>Brand Strategy</h4><p>Positioning that gives every discipline a clear direction.</p></div>
        </div>
      </div>
    </div>

    <div class="stats-row" data-reveal>
      <div class="stat-pill"><div class="num" data-count-to="10" data-suffix="+">0</div><div class="lbl">Years turning ideas into reality</div></div>
      <div class="stat-pill"><div class="num" data-count-to="12" data-suffix="+">0</div><div class="lbl">Brands across sectors</div></div>
      <div class="stat-pill"><div class="num" data-count-to="21" data-suffix="">0</div><div class="lbl">Execution partners, 4 states</div></div>
      <div class="stat-pill"><div class="num">360°</div><div class="lbl">Capability, one roof</div></div>
    </div>
  </div>
</section>


